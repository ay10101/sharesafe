# ShareSafe Environment Configuration
# Copy to .env for local development

# Database path (use persistent volume path in production, e.g. /data/sharesafe.db)
DATABASE_PATH=data/sharesafe.db

# Authentication secret for HMAC-SHA256 tokens
AUTH_SECRET=sharesafe-super-secret-key-change-for-production

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

